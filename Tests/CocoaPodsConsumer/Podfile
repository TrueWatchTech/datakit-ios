platform :ios, '15.0'

workspace 'Consumer'
project 'Consumer.xcodeproj'
use_frameworks!

sdk_source_path = ENV.fetch('TRUEWATCH_SDK_SOURCE_PATH', '../..')

target 'ObjCConsumer' do
  pod 'TrueWatchSDK', :path => sdk_source_path
  pod 'TrueWatchSDK/SessionReplay', :path => sdk_source_path
end

target 'SwiftConsumer' do
  pod 'TrueWatchSDK', :path => sdk_source_path
end

target 'SwiftUIConsumer' do
  pod 'TrueWatchSDK', :path => sdk_source_path
end
